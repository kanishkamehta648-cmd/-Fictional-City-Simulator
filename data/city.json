{
  "name": "Lumen Bay",
  "note": "Fictional city. A river runs west to east at about y=45. Only 3 bridges cross it, which makes the city fragile and the simulation interesting. Each agent represents about 10 real residents.",
  "neighbourhoods": [
    { "id": "northfield", "name": "Northfield", "type": "residential", "x": 18, "y": 18, "agents": 700, "jobs": 100,  "shops": 150, "income": "middle", "carOwnership": 0.75, "floodRisk": 0.1, "basePowerMW": 9.0 },
    { "id": "hillcrest",  "name": "Hillcrest",  "type": "residential", "x": 55, "y": 12, "agents": 400, "jobs": 50,   "shops": 60,  "income": "high",   "carOwnership": 0.95, "floodRisk": 0.0, "basePowerMW": 6.5 },
    { "id": "techpark",   "name": "Tech Park",  "type": "jobs",        "x": 85, "y": 25, "agents": 50,  "jobs": 700,  "shops": 30,  "income": "high",   "carOwnership": 0.9,  "floodRisk": 0.0, "basePowerMW": 14.0 },
    { "id": "cbd",        "name": "Central Business District", "type": "jobs", "x": 62, "y": 55, "agents": 100, "jobs": 900, "shops": 300, "income": "high", "carOwnership": 0.6, "floodRisk": 0.3, "basePowerMW": 18.0 },
    { "id": "oldtown",    "name": "Old Town",   "type": "mixed",       "x": 45, "y": 62, "agents": 350, "jobs": 350,  "shops": 400, "income": "middle", "carOwnership": 0.5,  "floodRisk": 0.4, "basePowerMW": 11.0 },
    { "id": "riverside",  "name": "Riverside",  "type": "residential", "x": 22, "y": 58, "agents": 500, "jobs": 150,  "shops": 120, "income": "middle", "carOwnership": 0.6,  "floodRisk": 0.9, "basePowerMW": 7.5 },
    { "id": "harbor",     "name": "Harbor",     "type": "industrial",  "x": 40, "y": 85, "agents": 250, "jobs": 600,  "shops": 40,  "income": "low",    "carOwnership": 0.45, "floodRisk": 0.6, "basePowerMW": 16.0 },
    { "id": "eastgate",   "name": "Eastgate",   "type": "residential", "x": 85, "y": 70, "agents": 650, "jobs": 150,  "shops": 100, "income": "low",    "carOwnership": 0.35, "floodRisk": 0.2, "basePowerMW": 8.0 }
  ],

  "roads": [
    { "id": "e1",  "name": "Northfield Road",   "from": "northfield", "to": "hillcrest", "km": 6.0,  "freeFlowMin": 8,  "capacity": 1500, "bridge": false, "floodProne": false },
    { "id": "e2",  "name": "Hillcrest Avenue",  "from": "hillcrest",  "to": "techpark",  "km": 5.0,  "freeFlowMin": 6,  "capacity": 1500, "bridge": false, "floodProne": false },
    { "id": "e3",  "name": "Crown Bridge",      "from": "northfield", "to": "cbd",       "km": 9.0,  "freeFlowMin": 12, "capacity": 1800, "bridge": true,  "floodProne": true },
    { "id": "e4",  "name": "Kings Bridge",      "from": "hillcrest",  "to": "cbd",       "km": 7.0,  "freeFlowMin": 9,  "capacity": 1400, "bridge": true,  "floodProne": true },
    { "id": "e5",  "name": "Tech Bridge",       "from": "techpark",   "to": "eastgate",  "km": 10.0, "freeFlowMin": 11, "capacity": 1200, "bridge": true,  "floodProne": true },
    { "id": "e6",  "name": "Market Street",     "from": "cbd",        "to": "oldtown",   "km": 3.0,  "freeFlowMin": 5,  "capacity": 1600, "bridge": false, "floodProne": false },
    { "id": "e7",  "name": "Riverbank Road",    "from": "oldtown",    "to": "riverside", "km": 3.0,  "freeFlowMin": 5,  "capacity": 1200, "bridge": false, "floodProne": true },
    { "id": "e8",  "name": "Embankment Way",    "from": "riverside",  "to": "harbor",    "km": 4.0,  "freeFlowMin": 6,  "capacity": 1000, "bridge": false, "floodProne": true },
    { "id": "e9",  "name": "Harbor Road",       "from": "oldtown",    "to": "harbor",    "km": 4.5,  "freeFlowMin": 7,  "capacity": 1300, "bridge": false, "floodProne": false },
    { "id": "e10", "name": "Eastern Boulevard", "from": "cbd",        "to": "eastgate",  "km": 5.0,  "freeFlowMin": 8,  "capacity": 1300, "bridge": false, "floodProne": false },
    { "id": "e11", "name": "Dockside Road",     "from": "eastgate",   "to": "harbor",    "km": 6.0,  "freeFlowMin": 9,  "capacity": 1100, "bridge": false, "floodProne": false }
  ],

  "busLines": [
    { "id": "L1", "name": "Crown Line",  "stops": ["northfield", "cbd", "oldtown", "riverside"], "headwayMin": 10, "buses": 12, "capacityPerBus": 60, "fare": 1.0 },
    { "id": "L2", "name": "East Express", "stops": ["eastgate", "cbd", "oldtown", "harbor"],     "headwayMin": 12, "buses": 10, "capacityPerBus": 60, "fare": 1.0 },
    { "id": "L3", "name": "Tech Shuttle", "stops": ["hillcrest", "techpark", "eastgate"],        "headwayMin": 15, "buses": 6,  "capacityPerBus": 50, "fare": 1.2 }
  ],

  "businesses": {
    "retail":   { "revenuePerVisit": 18, "lostRevenueIfCustomersLate": 0.0, "powerSensitivity": 0.8 },
    "office":   { "revenuePerWorkerDay": 90, "productivityLossPerLateMin": 0.004, "powerSensitivity": 0.9 },
    "industry": { "revenuePerWorkerDay": 70, "productivityLossPerLateMin": 0.006, "powerSensitivity": 1.0 }
  },

  "utilities": {
    "power": { "supplyCapacityMW": 105, "heatwaveDemandMultiplier": 1.35, "peakHourMultiplier": 1.25 },
    "water": { "supplyCapacityML": 60, "baseDemandMLPer1000Residents": 4.0, "floodSupplyReduction": 0.35 }
  },

  "budget": {
    "dailyReserve": 25000,
    "businessTaxRate": 0.08,
    "incomeTaxPerWorkerDay": 6,
    "busCostPerBusHour": 45,
    "busHoursPerDay": 16,
    "roadRepairCostPerDamagedEdge": 8000,
    "emergencySpendingLimit": 40000
  },

  "assumptions": {
    "peakWindowHours": 2,
    "congestionFormula": "travelTime = freeFlow * (1 + 0.15 * (volume / capacity) ^ 4)",
    "modeChoice": "logit on generalized cost = time + valueOfTimeFactor * cost + wait penalty",
    "valueOfTimeCreditsPerMin": 0.3,
    "busWaitPenaltyMultiplier": 1.8,
    "walkSpeedKmh": 4.5,
    "maxWalkKm": 3.0,
    "latenessToleranceMin": 5,
    "shopVisitDropPerExtraTripMin": 0.012,
    "busSpeedFactorVsCar": 0.85,
    "heatwaveWalkPenaltyMultiplier": 1.5,
    "agentRepresentsResidents": 10
  },

  "events": [
    { "id": "bus_cut",     "name": "Bus frequency cut",  "params": { "cutFraction": 0.3 } },
    { "id": "bridge_close", "name": "Bridge closure",    "params": { "roadId": "e3" } },
    { "id": "flood",       "name": "River flood",        "params": { "closeFloodProne": true, "waterReduction": 0.35 } },
    { "id": "heatwave",    "name": "Heatwave",           "params": { "powerMultiplier": 1.35, "walkPenalty": 1.5 } },
    { "id": "strike",      "name": "Transit strike",     "params": { "serviceRemaining": 0.1 } }
  ],

  "responses": [
    { "id": "add_buses",     "name": "Add buses on surviving corridor", "cost": 12000 },
    { "id": "stagger_hours", "name": "Stagger work start times",        "cost": 2000 },
    { "id": "shuttle",       "name": "Temporary shuttle / park-and-ride", "cost": 9000 },
    { "id": "emergency_fund", "name": "Emergency repair spending",      "cost": 20000 },
    { "id": "do_nothing",    "name": "Do nothing",                      "cost": 0 }
  ]
}
